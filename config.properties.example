# Configuração de conexão com o banco de dados MySQL

# 1. Copie este arquivo e renomeie a cópia para: config.properties
# 2. Preencha os valores abaixo com os dados do SEU MySQL local
# 3. NÃO envie o config.properties para o GitHub (ele já está no .gitignore)

# Endereço do banco: geralmente localhost:3306 + nome do banco criado
db.url=jdbc:mysql://localhost:3306/vetcare

# Usuário do MySQL (geralmente "root", a menos que você tenha criado outro)
db.usuario=root

# Senha do seu MySQL local
db.senha=SUA_SENHA_AQUI